{
  "version": 2,
  "builds": [
    {
      "src": "Pyconcept/api/chat.py",
      "use": "@vercel/python"
    },
    {
      "src": "Pyconcept/api/run-python.py",
      "use": "@vercel/python"
    },
    {
      "src": "Pyconcept/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "Pyconcept/api/chat.py"
    },
    {
      "src": "/api/run-python",
      "dest": "Pyconcept/api/run-python.py"
    },
    {
      "src": "/(.*)",
      "dest": "Pyconcept/$1"
    }
  ]
}
